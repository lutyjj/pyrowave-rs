+static pyrowave_result pyrowave_image_create_internal(
+		const pyrowave_image_create_info *info, pyrowave_image *out_image, bool *fd_consumed)
 {
 	Util::set_thread_logging_interface(&null_logger);
 	if (!info->device || !info->image_create_info)
@@ -583,6 +587,7 @@
 	image_create_info.misc = IMAGE_MISC_EXTERNAL_MEMORY_BIT | IMAGE_MISC_NO_DEFAULT_VIEWS_BIT;
 	image_create_info.external.handle = (decltype(image_create_info.external.handle))info->external_handle;
 	image_create_info.external.memory_handle_type = info->handle_type;
+	image_create_info.external.imported_fd_consumed = fd_consumed;
 	image_create_info.pnext = const_cast<void *>(info->image_create_info->pNext);
 	image_create_info.layout = ImageLayout::General;
 	image_create_info.initial_layout = VK_IMAGE_LAYOUT_UNDEFINED;
@@ -628,6 +633,30 @@
 	*out_image = image;
 	return PYROWAVE_SUCCESS;
 }
+
+pyrowave_result pyrowave_image_create(const pyrowave_image_create_info *info, pyrowave_image *out_image)
+{
+	return pyrowave_image_create_internal(info, out_image, nullptr);
+}
+
+#ifndef _WIN32
+pyrowave_result pyrowave_image_create_owned_fd(const pyrowave_image_create_info *info, pyrowave_image *out_image)
+{
+	if (info->handle_type != VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT)
+	{
+		::close(int(info->external_handle));
+		return PYROWAVE_ERROR_INVALID_ARGUMENT;
+	}
+
+	bool consumed = false;
+	auto result = pyrowave_image_create_internal(info, out_image, &consumed);
+	// Allocation can succeed before binding or mapping fails. Only the allocator
+	// knows whether Vulkan consumed the fd; the final result cannot tell us.
+	if (!consumed)
+		::close(int(info->external_handle));
+	return result;
+}
+#endif
 
