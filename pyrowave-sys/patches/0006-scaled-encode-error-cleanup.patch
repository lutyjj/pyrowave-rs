Complete queued scaling and release external images on inner-encoder failure.

Reject externally supplied command buffers with acquire/release operations
before recording any work. Cleanup remains off the successful encoding path.

--- a/pyrowave_c.cpp
+++ b/pyrowave_c.cpp
@@ -1021,6 +1021,20 @@
 	}
 }
 
+static void pyrowave_device_release_images(CommandBuffer &cmd, const pyrowave_gpu_sync_operation *release)
+{
+	if (!release)
+		return;
+	for (size_t i = 0; i < release->num_images; i++)
+	{
+		cmd.release_image_barrier(*release->images[i].image->img,
+		                          VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL,
+		                          VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
+		                          VK_ACCESS_2_SHADER_SAMPLED_READ_BIT,
+		                          release->images[i].queue_family_index);
+	}
+}
+
 static pyrowave_result
 pyrowave_encoder_encode_gpu_synchronous_inner(pyrowave_encoder encoder,
                                               const pyrowave_gpu_sync_operation *acquire,
@@ -1111,17 +1125,7 @@
