+static bool validate_payload(const BitstreamHeader *header)
+{
+	const auto *data = reinterpret_cast<const uint8_t *>(header);
+	const size_t size = header->payload_words * sizeof(uint32_t);
+	const unsigned blocks = Util::popcount32(header->ballot);
+	size_t offset = sizeof(*header) + 3 * blocks;
+	if (offset > size)
+		return false;
+
+	unsigned significant = 0;
+	for (unsigned block = 0; block < blocks; block++)
+	{
+		const unsigned control = data[8 + 2 * block] | (unsigned(data[9 + 2 * block]) << 8);
+		const unsigned q_bits = data[8 + 2 * blocks + block] & 15;
+		for (unsigned group = 0; group < 8; group++)
+		{
+			const unsigned planes = q_bits + ((control >> (2 * group)) & 3);
+			if (planes > size - offset)
+				return false;
+			unsigned nonzero = 0;
+			for (unsigned plane = 0; plane < planes; plane++)
+				nonzero |= data[offset++];
+			// The shader treats a zero control word as an empty 8x8 block.
+			if (control != 0)
+				significant += Util::popcount32(nonzero);
+		}
+	}
+	return (significant + 7) / 8 <= size - offset;
+}
