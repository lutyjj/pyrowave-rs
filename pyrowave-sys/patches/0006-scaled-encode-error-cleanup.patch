-									   VK_IMAGE_LAYOUT_GENERAL, VK_IMAGE_LAYOUT_GENERAL,
-									   VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT,
-									   VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT,
-									   release->images[i].queue_family_index);
-		}
