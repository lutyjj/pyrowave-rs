Reject negative signed frame-context indexes before storing or indexing them.

The upstream guards check only the upper bound. The encoder setter and
both asynchronous decoder entry points must enforce the same 0..2 range.

--- a/pyrowave_c.cpp
+++ b/pyrowave_c.cpp
@@ -1430,7 +1430,7 @@
 pyrowave_result
 pyrowave_encoder_set_frame_context(pyrowave_encoder encoder, int context)
 {
-	if (context >= PYROWAVE_MAX_FRAME_CONTEXTS)
+	if (context < 0 || context >= PYROWAVE_MAX_FRAME_CONTEXTS)
 		return PYROWAVE_ERROR_INVALID_ARGUMENT;
 
 	encoder->context = context;
@@ -1943,7 +1943,7 @@
 	if (decoder->pyro_device->cmd)
 		return PYROWAVE_ERROR_INVALID_ARGUMENT;
 
-	if (context_index >= PYROWAVE_MAX_FRAME_CONTEXTS)
+	if (context_index < 0 || context_index >= PYROWAVE_MAX_FRAME_CONTEXTS)
 		return PYROWAVE_ERROR_INVALID_ARGUMENT;
 
 	Util::register_thread_index(0);
@@ -2140,7 +2140,7 @@
 pyrowave_result
 pyrowave_decoder_decode_cpu_buffer_complete(pyrowave_decoder decoder, const pyrowave_cpu_buffer *buffers, int context_index)
 {
-	if (context_index >= PYROWAVE_MAX_FRAME_CONTEXTS)
+	if (context_index < 0 || context_index >= PYROWAVE_MAX_FRAME_CONTEXTS)
 		return PYROWAVE_ERROR_INVALID_ARGUMENT;
 
 	auto &context = decoder->contexts[context_index];
